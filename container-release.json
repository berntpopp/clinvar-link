{
  "schema_version": 1,
  "dockerfile": "docker/Dockerfile",
  "target": "production",
  "platform": "linux/amd64",
  "service": {
    "compose_files": [
      "docker/docker-compose.yml",
      "docker/docker-compose.prod.yml"
    ],
    "deployed_compose_files": [
      "docker/docker-compose.npm.yml"
    ],
    "name": "clinvar-link",
    "container_port": 8000,
    "health_path": "/health",
    "mcp_path": "/mcp",
    "startup_timeout_seconds": 900,
    "auxiliary": [
      {
        "name": "clinvar-data-init",
        "role": "init",
        "egress": "approved-networks",
        "writable_targets": [
          "/data",
          "/tmp"
        ]
      }
    ]
  },
  "data": {
    "mode": "external-reference",
    "release_tag": "bundle-2026-10-19",
    "digest": "sha256:f8f40ca837bf047628b99800e93ffecd681280e23b9617b9aff56895f7032635",
    "schema_compatibility": ["1"],
    "image_allowlist": [
      "opt/venv/lib/python3.14/site-packages/clinvar_link/data/__init__.py",
      "opt/venv/lib/python3.14/site-packages/clinvar_link/data/indexes.sql",
      "opt/venv/lib/python3.14/site-packages/clinvar_link/data/repository.py",
      "opt/venv/lib/python3.14/site-packages/clinvar_link/data/review_status_stars.yaml",
      "opt/venv/lib/python3.14/site-packages/clinvar_link/data/schema.sql"
    ]
  },
  "data_identity_contract": "runtime-v1",
  "definitions": {
    "contract": "data-bound"
  },
  "smoke": {
    "profile": "immutable-bundle"
  },
  "smoke_environment": [
    "CLINVAR_LINK_BUNDLE_EXPECTED_SHA256=21fb57baf41bdbb99976d0f4cc53ea6b00f277881f469e79a7e07153fb691b85"
  ],
  "preparation": "docker/ci-prepare-smoke.sh"
}
