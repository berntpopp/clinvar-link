    "auxiliary": [
      {
        "name": "clinvar-data-init",
        "role": "init",
        "egress": "approved-networks",
        "writable_targets": [
          "/data",
          "/tmp"
        ]
      }
    ]
  },
  "data": {
    "mode": "external-reference",
    "release_tag": "bundle-2026-11-09-r2",
    "digest": "sha256:c9b952add7fe78ebd6bcbd0fe0648014e9d01f7356d770e0e9b838c254d72287",
    "schema_compatibility": ["1"],
    "image_allowlist": [
